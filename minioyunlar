<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#9DC3FF">
<title>πksel - Minioyunlar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{color-scheme:light dark}
body{--page:#9DC3FF;--c1:#001E6F;--c2:#002E92;--fg:#9DC3FF;--accent:#001E6F;--glow:rgba(0,8,45,.30);--grad:linear-gradient(135deg,var(--c1) 0%,var(--c2) 50%,var(--c1) 100%);--tx:env(safe-area-inset-top,0px);--bx:env(safe-area-inset-bottom,0px)}
body.dark{--page:#00072C;--c1:#9DC3FF;--c2:#6FA5FC;--fg:#00072C;--accent:#9DC3FF;--glow:rgba(255,255,255,.4)}
*{box-sizing:border-box;margin:0;padding:0}
html{min-height:100%;scroll-behavior:smooth;overflow-x:hidden}
body{min-height:100vh;background:var(--page);color:var(--fg);font-family:Poppins,sans-serif;overflow-x:hidden;transition:background .65s ease;-webkit-font-smoothing:antialiased;padding-top:var(--tx);padding-bottom:var(--bx);display:flex;flex-direction:column}
a,button{-webkit-tap-highlight-color:transparent;font:inherit}
a{color:inherit;text-decoration:none}
.page{width:min(95vw,820px);margin:0 auto;padding:12px 0 32px;flex:1}
.frame{animation:frameIn .6s cubic-bezier(.18,.8,.24,1) backwards;animation-delay:var(--d,0s)}
.rise{animation:riseIn .6s cubic-bezier(.18,.8,.24,1) backwards;animation-delay:calc(var(--d,0s) + .25s)}
@keyframes frameIn{from{opacity:0;transform:translateY(28px)}}
@keyframes riseIn{from{opacity:0;transform:translateY(20px)}}
.top-nav{height:50px;border-radius:40px;padding:0 52px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background:var(--grad);box-shadow:0 10px 28px rgba(0,20,100,.08)}
.nav-links{display:flex;align-items:center;gap:40px;height:100%}
.nav-link{position:relative;font-size:15px;font-weight:500;white-space:nowrap;transition:transform .25s ease}
.nav-link:hover{transform:translateY(-1px)}
.theme-toggle{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:38px;height:38px;border:0;border-radius:50%;cursor:pointer;display:grid;place-items:center;color:var(--accent);background:var(--page);transition:transform .3s ease,background .65s ease,color .65s ease}
.theme-toggle:hover{transform:translateY(-50%) scale(1.08)}
.theme-icon{width:24px;height:24px;display:block}
.ray{stroke:currentColor;stroke-width:2;stroke-linecap:round}
body.dark .ray{opacity:0}
.core{transform:scale(.68);transform-origin:16px 16px}
.bite{transform:translate(14px,-14px)}
body.dark .core{transform:scale(1)}body.dark .bite{transform:translate(0,0)}
body.ready .core,body.ready .bite{transition:transform .6s cubic-bezier(.4,0,.2,1)}
.section-title{text-align:center;color:var(--accent);font-size:24px;line-height:1;font-weight:700;letter-spacing:-.7px;margin:28px 0 18px}
.cards-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.game-card{position:relative;border-radius:28px;background:var(--grad);color:var(--fg);padding:14px 20px;display:flex;align-items:center;gap:14px;min-height:104px;overflow:hidden;box-shadow:0 10px 25px rgba(0,20,110,.07);transition:transform .35s cubic-bezier(.18,.8,.22,1),box-shadow .35s ease}
.game-card::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .4s ease;background:radial-gradient(ellipse 170px 120px at var(--mx,50%) var(--my,50%),var(--glow),transparent 72%)}
@media(hover:hover){.game-card:hover{transform:translateY(-3px) scale(1.012);box-shadow:0 14px 30px rgba(0,20,110,.14)}.game-card:hover::before{opacity:1}}
.game-card:active{transform:scale(.98)}
.game-card>*{position:relative;z-index:1}
.game-icon{width:64px;height:64px;flex:0 0 64px;border-radius:16px;display:grid;place-items:center;background:var(--page);color:var(--accent);transition:background .65s ease,color .65s ease}
.game-icon svg{width:46px;height:46px;display:block}
.game-name{font-size:24px;font-weight:700;letter-spacing:-.7px;line-height:1.12;flex:1;min-width:0}
.coming .game-name{font-size:21px}
footer{background:var(--grad);color:var(--fg);min-height:110px;padding:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center}
.footer-line{font-size:15px;line-height:1.4;font-weight:500}
.footer-link{transition:opacity .25s ease,transform .25s ease}.footer-link:hover{opacity:.72;transform:translateY(-1px)}
.game-card:focus-visible,.nav-link:focus-visible,.theme-toggle:focus-visible,.footer-link:focus-visible{outline:3px solid currentColor;outline-offset:4px}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
@media(max-width:700px){.page{width:calc(100vw - 44px);padding:11px 0 26px}.top-nav{height:46px;padding:0 46px}.nav-links{gap:28px}.nav-link{font-size:13px}.theme-toggle{width:34px;height:34px;right:6px}.theme-icon{width:21px;height:21px}.section-title{font-size:17px;margin:20px 0 12px}.cards-list{grid-template-columns:1fr;gap:10px}.game-card{min-height:88px;padding:12px 16px;gap:12px;border-radius:22px}.game-icon{width:48px;height:48px;flex-basis:48px;border-radius:13px}.game-icon svg{width:36px;height:36px}.game-name{font-size:17px;letter-spacing:-.5px}.coming .game-name{font-size:16px}footer{min-height:96px;padding:16px 12px;gap:5px}.footer-line{font-size:13px}}
@media(max-width:420px){.page{width:calc(100vw - 36px)}.top-nav{height:42px;padding:0 42px}.nav-links{gap:22px}.nav-link{font-size:11px}.theme-toggle{width:32px;height:32px;right:5px}.theme-icon{width:20px;height:20px}.section-title{font-size:15px}.game-card{min-height:82px;padding:10px 14px;gap:10px}.game-icon{width:44px;height:44px;flex-basis:44px}.game-icon svg{width:33px;height:33px}.game-name{font-size:15px}.coming .game-name{font-size:14px}footer{min-height:88px}.footer-line{font-size:11px}}
</style>
</head>
<body>
<div class="page">
  <nav class="top-nav frame" style="--d:0s" aria-label="Əsas naviqasiya">
    <div class="nav-links rise">
      <a class="nav-link" href="index.html">Əsas Səhifə</a>
      <a class="nav-link" href="contact.html">Bizimlə Əlaqə</a>
    </div>
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="Gecə rejiminə keç">
      <svg class="theme-icon rise" viewBox="0 0 32 32" aria-hidden="true">
        <defs><mask id="biteMask" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32"><rect width="32" height="32" fill="#fff"/><circle class="bite" cx="21" cy="11" r="7.5" fill="#000"/></mask></defs>
        <g><g transform="rotate(0 16 16)"><line class="ray" x1="16" y1="3.5" x2="16" y2="6.5"/></g><g transform="rotate(45 16 16)"><line class="ray" x1="16" y1="3.5" x2="16" y2="6.5"/></g><g transform="rotate(90 16 16)"><line class="ray" x1="16" y1="3.5" x2="16" y2="6.5"/></g><g transform="rotate(135 16 16)"><line class="ray" x1="16" y1="3.5" x2="16" y2="6.5"/></g><g transform="rotate(180 16 16)"><line class="ray" x1="16" y1="3.5" x2="16" y2="6.5"/></g><g transform="rotate(225 16 16)"><line class="ray" x1="16" y1="3.5" x2="16" y2="6.5"/></g><g transform="rotate(270 16 16)"><line class="ray" x1="16" y1="3.5" x2="16" y2="6.5"/></g><g transform="rotate(315 16 16)"><line class="ray" x1="16" y1="3.5" x2="16" y2="6.5"/></g></g>
        <g mask="url(#biteMask)"><circle class="core" cx="16" cy="16" r="9" fill="currentColor"/></g>
      </svg>
    </button>
  </nav>

  <h2 class="section-title rise" style="--d:.1s">Minioyunlar</h2>
  <main class="cards-list" aria-label="Minioyunlar">
    <a class="game-card frame" style="--d:.2s" href="piksel_xoxo" aria-label="πksel XOXO">
      <span class="game-icon rise" aria-hidden="true">
        <svg viewBox="0 0 90 90" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 12h66M12 45h66M12 78h66M12 12v66M45 12v66M78 12v66" stroke="currentColor" stroke-width="5" stroke-linecap="round" opacity=".28"/>
          <path d="M20 20 37 37m0-17L20 37M53 53l18 18m0-18L53 71" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="61.5" cy="28.5" r="9.5" stroke="currentColor" stroke-width="7"/>
        </svg>
      </span>
      <span class="game-name rise">πksel XOXO</span>
    </a>
    <a class="game-card coming frame" style="--d:.3s" href="" aria-label="Tezliklə">
      <span class="game-icon rise" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="3.5"/><path d="M24 13v12l8 5" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M35.5 8.5 39 5m-30 3.5L5.5 5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span>
      <span class="game-name rise">Tezliklə...</span>
    </a>
    <a class="game-card coming frame" style="--d:.4s" href="" aria-label="Tezliklə">
      <span class="game-icon rise" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="3.5"/><path d="M24 13v12l8 5" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M35.5 8.5 39 5m-30 3.5L5.5 5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span>
      <span class="game-name rise">Tezliklə...</span>
    </a>
    <a class="game-card coming frame" style="--d:.5s" href="" aria-label="Tezliklə">
      <span class="game-icon rise" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="3.5"/><path d="M24 13v12l8 5" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M35.5 8.5 39 5m-30 3.5L5.5 5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span>
      <span class="game-name rise">Tezliklə...</span>
    </a>
  </main>
</div>
<footer>
  <div class="footer-line">Unikal İntellektual Oyunlar Platforması</div>
  <a class="footer-line footer-link" href="https://www.instagram.com/piksel.iok" target="_blank" rel="noopener noreferrer">©πksel intellektual oyunlar klubu</a>
  <a class="footer-line footer-link" href="https://www.instagram.com/onurelzh" target="_blank" rel="noopener noreferrer">©Onur Əlizadə</a>
</footer>
<script>
const themeToggle=document.getElementById("themeToggle");
function setTheme(dark){document.body.classList.toggle("dark",dark);try{localStorage.setItem("piksel-theme",dark?"dark":"light")}catch(e){}themeToggle.setAttribute("aria-label",dark?"Gündüz rejiminə keç":"Gecə rejiminə keç")}
function initTheme(){let saved=null;try{saved=localStorage.getItem("piksel-theme")}catch(e){}if(saved==="dark")return setTheme(true);if(saved==="light")return setTheme(false);setTheme(!!(window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches))}
themeToggle.addEventListener("click",()=>setTheme(!document.body.classList.contains("dark")));
initTheme();requestAnimationFrame(()=>requestAnimationFrame(()=>document.body.classList.add("ready")));
document.querySelectorAll(".game-card").forEach(card=>card.addEventListener("pointermove",e=>{const r=card.getBoundingClientRect();card.style.setProperty("--mx",(e.clientX-r.left)+"px");card.style.setProperty("--my",(e.clientY-r.top)+"px")}));
</script>
</body>
</html>
