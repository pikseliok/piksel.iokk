function formatName(format){

  return {
    nhn:"Nə? Harada? Nə Zaman?",
    brain:"Breyn Rinq",
    xemse:"Xəmsə",
    ferdi:"Fərdi oyun"
  }[format] || "";
}

function initials(name=""){

  const parts=name.trim().split(/\s+/).filter(Boolean);

  if(!parts.length)return "π";

  return parts
    .slice(0,2)
    .map(x=>x.charAt(0).toLocaleUpperCase("az-AZ"))
    .join("");
}


