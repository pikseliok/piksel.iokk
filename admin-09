    "Paket public saytdan çıxarılacaq və arxivə göndəriləcək.",
    ()=>{

      const p=packages.find(x=>x.id===id);

      if(!p)return;

      p.status="archived";
      p.archivedAt=new Date().toISOString();

      save(STORAGE.packages,packages);

      renderPackages();
    }
  );
}

function restorePackage(id){

  const p=packages.find(x=>x.id===id);

  if(!p)return;

  const archived=new Date(p.archivedAt);
  const now=new Date();

  const days=(now-archived)/(1000*60*60*24);

  if(days>14){
    alert("Bu paketin 14 günlük bərpa müddəti bitib.");
    return;
  }

  p.status="draft";
  delete p.archivedAt;

  save(STORAGE.packages,packages);

  renderPackages();
}


/* =========================
   AUTHORS
========================= */

function newAuthor(){

  editingAuthorId=null;

  openAuthorModal();
}

function openAuthorModal(author=null){

  const name=prompt(
    author
    ? "Müəllif adını redaktə et:"
    : "Müəllifin ad və soyadını yaz:",
    author?.name || ""
  );

  if(name===null)return;

  const clean=name.trim();

  if(!clean)return;

  if(author){

    author.name=clean;

  }else{

    authors.push({
      id:uid(),
      name:clean,
      packages:[]
    });

  }

  save(STORAGE.authors,authors);

  renderAuthors();
  fillAuthorSuggestions();
}

function renderAuthors(){

  const el=document.getElementById("authorList");

  if(!authors.length){
    el.innerHTML='<div class="card empty">Hələ müəllif əlavə edilməyib.</div>';
    return;
  }

  el.innerHTML=authors.map(a=>{

    const authorPackages=packages.filter(p=>
      String(p.authors||"")
        .split(",")
        .map(x=>x.trim())
        .includes(a.name)
    );

    const count=authorPackages.length;

    return `

      <div class="author-card">

        <div class="item-row">

          <div class="author-icon">
            ${escapeHTML(initials(a.name))}
          </div>

          <div class="item-info">

            <strong>${escapeHTML(a.name)}</strong>

            <small>${count} paket</small>

          </div>

          <div class="item-actions">

            <button class="mini-btn"
              onclick="openAuthorPackages('${a.id}')">
              →
            </button>

            <button class="mini-btn"
              onclick="openAuthorModal(${JSON.stringify(a).replaceAll('"','&quot;')})">
              ✎
            </button>

            <button class="mini-btn danger"
              onclick="deleteAuthor('${a.id}')">
              🗑
            </button>

          </div>

        </div>

        <div id="authorPackages_${a.id}" class="hidden"
             style="margin-top:12px">

          ${
            authorPackages.length
            ? authorPackages.map(p=>`
                <div class="package-card"
                     onclick="editPackage('${p.id}')"
                     style="cursor:pointer">
                  <div class="item-row">
                    <div class="package-icon">
                      ${escapeHTML(initials(p.name))}
                    </div>
                    <div class="item-info">
                      <strong>${escapeHTML(p.name)}</strong>
                      <small>${escapeHTML(formatName(p.format))}</small>
                    </div>
                  </div>
                </div>
              `).join("")
            : '<div class="empty">Bu müəllifə aid paket yoxdur.</div>'
          }

        </div>

      </div>

    `;
  }).join("");
}

function openAuthorPackages(id){

  const box=document.getElementById("authorPackages_"+id);

  if(box)box.classList.toggle("hidden");
}

function deleteAuthor(id){

  const author=authors.find(x=>x.id===id);

  if(!author)return;

  confirmModal(
    "Müəllifi sil",
    `"${author.name}" müəllifi silinsin?`,
    ()=>{

      authors=authors.filter(x=>x.id!==id);

      save(STORAGE.authors,authors);

      renderAuthors();
      fillAuthorSuggestions();
    }
  );
}

function fillAuthorSuggestions(){

  const list=document.getElementById("authorSuggestions");

  list.innerHTML=authors
    .map(a=>`<option value="${escapeHTML(a.name)}"></option>`)
    .join("");
}

function authorSuggest(){

