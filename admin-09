/* =========================
   ANNOUNCEMENTS
========================= */

function newAnnouncement(){

  const title=prompt("Yarış adı:");

  if(title===null || !title.trim())return;

  const date=prompt(
    "Yarış tarixi və saatı:\nMəsələn: 2026-09-20T13:00"
  );

  if(!date)return;

  const place=prompt("Yarış məkanı (boş qala bilər):","");

  const organizer=prompt("Yarış təşkilatçısı:","");

  const authorsText=prompt("Müəlliflər:","");

  const link=prompt("Dəvət linki:","");

  const image=prompt(
    "Yarış afişasının şəkil məlumatı:\n\nİlkin versiyada şəkil üçün URL daxil edə bilərsən."
  );

  const start=new Date(date);

  if(isNaN(start.getTime())){
    alert("Tarix formatı yanlışdır.");
    return;
  }

  const expiresAt=new Date(
    start.getTime()+2*60*60*1000
  ).toISOString();

  announcements.push({
    id:uid(),
    title:title.trim(),
    place:(place||"").trim(),
    date:start.toISOString(),
    organizer:(organizer||"").trim(),
    authors:(authorsText||"").trim(),
    inviteLink:(link||"").trim(),
    image:(image||"").trim(),
    expiresAt,
    createdAt:new Date().toISOString()
  });

  save(STORAGE.announcements,announcements);

  renderAnnouncements();
}

function renderAnnouncements(){

  const el=document.getElementById("announcementList");

  cleanupExpiredAnnouncements();

  if(!announcements.length){
    el.innerHTML='<div class="card empty">Aktiv elan yoxdur.</div>';
    return;
  }

  el.innerHTML=announcements.map(a=>`

    <div class="announcement-card">

      ${
        a.image
        ? `<img src="${escapeHTML(a.image)}"
                style="width:100%;max-height:220px;object-fit:cover;border-radius:15px;margin-bottom:12px">`
        : ""
      }

      <strong style="font-size:17px">
        ${escapeHTML(a.title)}
      </strong>

      <div style="margin-top:9px;line-height:1.8;font-size:13px">

        ${
          a.place
          ? `📍 ${escapeHTML(a.place)}<br>`
          : ""
        }

        📅 ${new Date(a.date).toLocaleString("az-AZ")}

        ${
          a.organizer
          ? `<br>🏢 ${escapeHTML(a.organizer)}`
          : ""
        }

        ${
          a.authors
          ? `<br>✍ ${escapeHTML(a.authors)}`
          : ""
        }

      </div>

      <div
        id="countdown_${a.id}"
        style="margin-top:12px;font-weight:900">
      </div>

      <div class="toolbar" style="margin-top:12px;margin-bottom:0">

        ${
          a.inviteLink
          ? `<button class="btn"
               onclick="window.open('${escapeHTML(a.inviteLink)}','_blank')">
               Dəvət linki
             </button>`
          : ""
        }

        <button class="btn danger"
          onclick="deleteAnnouncement('${a.id}')">
          Sil
        </button>

      </div>

    </div>

  `).join("");

  updateCountdowns();
}

function updateCountdowns(){

  announcements.forEach(a=>{

    const el=document.getElementById("countdown_"+a.id);

    if(!el)return;

    const target=new Date(a.date).getTime();
    const now=Date.now();

    const diff=target-now;

    if(diff<=0){

      const untilDelete=new Date(a.expiresAt).getTime()-now;

      if(untilDelete<=0){

        cleanupExpiredAnnouncements();
        return;
      }

      el.textContent="Yarış başladı";
      return;
    }

    const days=Math.floor(diff/86400000);
    const hours=Math.floor((diff%86400000)/3600000);
    const mins=Math.floor((diff%3600000)/60000);
    const secs=Math.floor((diff%60000)/1000);

    el.textContent=
      `Başlamasına ${days} gün ${hours} saat ${mins} dəqiqə ${secs} saniyə`;
  });
}

setInterval(updateCountdowns,1000);

function cleanupExpiredAnnouncements(){

  const now=Date.now();

  announcements=announcements.filter(a=>{
    return new Date(a.expiresAt).getTime()>now;
  });

  save(STORAGE.announcements,announcements);
}

function deleteAnnouncement(id){

  confirmModal(
    "Elanı sil",
    "Bu elan tamamilə silinsin?",
    ()=>{

      announcements=announcements.filter(x=>x.id!==id);

      save(STORAGE.announcements,announcements);

      renderAnnouncements();
    }
  );
}


/* =========================
   MODAL
========================= */

function confirmModal(title,text,callback){

  document.getElementById("modalTitle").textContent=title;
  document.getElementById("modalText").textContent=text;

  document.getElementById("modalBg").classList.add("show");

  document.getElementById("modalConfirm").onclick=()=>{

    closeModal();
    callback();

  };
}

function closeModal(){
  document.getElementById("modalBg").classList.remove("show");
}


/* =========================
   14 DAY ARCHIVE CLEANUP
========================= */

function cleanupArchivedPackages(){

  const now=Date.now();

  const before=packages.length;

  packages=packages.filter(p=>{

    if(p.status!=="archived")return true;

    if(!p.archivedAt)return true;

    const age=
      (now-new Date(p.archivedAt).getTime())/
      (1000*60*60*24);

    return age<=14;
  });

  if(before!==packages.length){
    save(STORAGE.packages,packages);
  }
}


/* =========================
   INIT
========================= */

cleanupArchivedPackages();
cleanupExpiredAnnouncements();

startAutosave();
checkSession();

</script>

