function startAutosave(){

  clearInterval(autosaveTimer);

  autosaveTimer=setInterval(()=>{

    if(
      document.getElementById("packageEditor").classList.contains("active")
    ){

      const name=document.getElementById("p_name").value.trim();

      if(name){

        const p=collectPackage();

        p.status="draft";

        const index=packages.findIndex(x=>x.id===p.id);

        if(index>=0){
          packages[index]=p;
        }else{
          packages.push(p);
        }

        save(STORAGE.packages,packages);

        editingPackageId=p.id;

        document.getElementById("autoSaveState").textContent=
          "Qaralama avtomatik saxlanıldı • "+
          new Date().toLocaleTimeString("az-AZ");
      }

    }

  },120000);
}


