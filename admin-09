function buildExistingStructure(format,structure){

  /*
    Mövcud strukturun sualları yenidən qurulur.
    Redaktə zamanı məlumatlar itməsin deyə
    yalnız mövcud sual mətnləri göstərilir.
  */

  const q = structure.questions || {};

  const questionKeys = Object.keys(q).sort();

  let html="";

  questionKeys.forEach((key,index)=>{

    const item=q[key];

    html+=`

      <div class="question-card">

        <div class="question-number">
          ${key}
        </div>

        <div class="field">
          <label>Sual</label>
          <textarea data-q="${key}" data-field="question">${escapeHTML(item.question||"")}</textarea>
        </div>

        <div class="grid">

          <div class="field">
            <label>Cavab</label>
            <textarea data-q="${key}" data-field="answer">${escapeHTML(item.answer||"")}</textarea>
          </div>

          <div class="field">
            <label>Sayılma meyarı</label>
            <textarea data-q="${key}" data-field="criteria">${escapeHTML(item.criteria||"")}</textarea>
          </div>

          <div class="field">
            <label>Şərh</label>
            <textarea data-q="${key}" data-field="comment">${escapeHTML(item.comment||"")}</textarea>
          </div>

          <div class="field">
            <label>Mənbə</label>
            <textarea data-q="${key}" data-field="source">${escapeHTML(item.source||"")}</textarea>
          </div>

        </div>

      </div>

    `;

  });

  if(!html){

    html=`
      <div class="notice">
        Bu paketdə sual strukturu qeyd olunmayıb.
        Yeni tur yaradaraq sualları əlavə edə bilərsən.
      </div>
    `;

  }

  return `
    <div class="card">
      <h3>Mövcud suallar</h3>
      ${html}
    </div>
  `;
}


/* =========================
   COLLECT PACKAGE
========================= */

function collectPackage(){

  const format=document.getElementById("p_format").value;

  return {
    id:editingPackageId || uid(),

    name:document.getElementById("p_name").value.trim(),

    organizer:document.getElementById("p_organizer").value.trim(),

    editors:document.getElementById("p_editors").value.trim(),

    authors:document.getElementById("p_authors").value.trim(),

    played:document.getElementById("p_played").value,

    added:document.getElementById("p_added").value || today(),

    format,

    image:document.getElementById("packageImagePreview").src || "",

    structure:collectStructure(format),

    status:
      editingPackageId
      ? (packages.find(x=>x.id===editingPackageId)?.status || "draft")
      : "draft",

    updatedAt:new Date().toISOString()
  };
}

function collectStructure(format){

  const data={
    format
  };

  document.querySelectorAll("[data-q]").forEach(el=>{

    const id=el.dataset.q;

    if(!data.questions)data.questions={};

    if(!data.questions[id]){
      data.questions[id]={};
    }

    const value=el.value.trim();

    if(value){
      data.questions[id][el.dataset.field]=value;
    }
  });

  document.querySelectorAll("[data-topic]").forEach(el=>{

    const id=el.dataset.topic;

    if(!data.topics)data.topics={};

    if(!data.topics[id]){
      data.topics[id]={};
    }

    const value=el.value.trim();

    if(value){
      data.topics[id][el.dataset.field]=value;
    }
  });

  document.querySelectorAll("[data-topic-author]").forEach(el=>{

    const id=el.dataset.topicAuthor;
    const value=el.value.trim();

    if(value){

      if(!data.topics)data.topics={};

      if(!data.topics[id]){
        data.topics[id]={};
      }

      data.topics[id].author=value;
    }
  });

  return data;
}


/* =========================
   SAVE DRAFT
========================= */

function saveDraft(){

  const p=collectPackage();

  if(!p.name){
    alert("Paket adını yaz.");
    return;
  }

  p.status="draft";

  const index=packages.findIndex(x=>x.id===p.id);

  if(index>=0){
    packages[index]=p;
  }else{
    packages.push(p);
  }

  save(STORAGE.packages,packages);

  editingPackageId=p.id;

  document.getElementById("saveStatus").textContent=
    "Qaralama saxlanıldı • "+new Date().toLocaleTimeString("az-AZ");

  renderPackages();
}

function publishPackage(){

  const p=collectPackage();

  if(!p.name){
    alert("Paket adını yaz.");
    return;
  }

  confirmModal(
    "Paketi yayımla",
    "Bu paket public saytda yayımlansın?",
    ()=>{
      p.status="published";

      const index=packages.findIndex(x=>x.id===p.id);

      if(index>=0){
        packages[index]=p;
      }else{
        packages.push(p);
      }

      save(STORAGE.packages,packages);

      editingPackageId=p.id;

      document.getElementById("saveStatus").textContent=
        "Paket yayımlandı • "+new Date().toLocaleTimeString("az-AZ");

      renderPackages();
    }
  );
}


